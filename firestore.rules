rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore is used strictly as a transient WebRTC signaling channel.
    // This app is auth-less (no Firebase Auth). Rules validate document shape only.
    // Documents auto-expire via Firebase TTL Extension (ttl field set to 14 days from creation).

    match /trips/{tripId} {
      // Changed 'read' to 'get' to explicitly block 'list' queries
      allow get: if isValidTripId(tripId);
      allow list: if false;       // STOPS DDOS/SCRAPING: No one can list all trips
      allow create, update: if isValidTripId(tripId) && isSignalingDocument();
      allow delete: if isValidTripId(tripId);

      // Subcollection: each peer writes their own signaling doc
      match /peers/{peerId} {
        // Host needs 'list' to listen for incoming peer connections via onSnapshot
        allow get, list: if isValidTripId(tripId);
        allow create, update: if isValidTripId(tripId) && isPeerSignalingDoc();
        allow delete: if isValidTripId(tripId);
      }
    }

    // This correctly blocks everything else
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidTripId(tripId) {
      return tripId.matches('^[A-Z2-9]{6}$');
    }

    function isSignalingDocument() {
      // Allow ownerId + optional ttl field for auto-expiry
      return request.resource.data.keys().hasOnly(['ownerId', 'ttl'])
        && ('ownerId' in request.resource.data && request.resource.data.ownerId is string);
    }

    function isPeerSignalingDoc() {
      return request.resource.data.keys().hasOnly(['memberSdp', 'hostSdp'])
        && ('memberSdp' in request.resource.data && request.resource.data.memberSdp is string)
        && (!('hostSdp' in request.resource.data) || request.resource.data.hostSdp is string);
    }
  }
}