rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore is used strictly as a transient WebRTC signaling channel.
    match /trips/{tripId} {
      allow read: if isValidTripId(tripId);
      allow create, update: if isValidTripId(tripId) && isSignalingOnlyDocument();
      allow delete: if isValidTripId(tripId);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidTripId(tripId) {
      return tripId.matches('^[A-Z2-9]{6}$');
    }

    function isSignalingOnlyDocument() {
      return request.resource.data.keys().hasOnly(['ownerId', 'expireAt', 'members'])
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId is string)
        && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is number)
        && (!('members' in request.resource.data) || request.resource.data.members is map);
    }
  }
}
